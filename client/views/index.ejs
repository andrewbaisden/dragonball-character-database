<%- include('includes/head.ejs') %>
<header class="site-header">
    <img src="/assets/dragonballLogo.png" alt="Dragon Ball" />
</header>
<main class="container searchContainer">
    <section class="hero">
        <p class="hero-kicker">Fighter Archive</p>
        <h1>Character<br>Database</h1>
        <p>Pick a name from the roster or type it into the search box to load their profile.</p>
    </section>
    <section class="roster-panel">
        <span class="panel-label">Roster</span>
        <div class="character-roster" aria-label="Character roster"></div>
    </section>
    <section class="search-panel search">
        <form class="dragonball-character">
            <div class="search-bar">
                <input type="text" class="search-characters" placeholder="Search for a character" autocomplete="off">
            </div>
        </form>
        <div class="search-alert"></div>
    </section>
    <section class="profile" aria-live="polite"></section>
</main>
<script src="/js/app.js"></script>
<%- include('includes/end.ejs') %>
